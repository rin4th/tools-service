# Postgres
POSTGRES_USER=pdftools
POSTGRES_PASSWORD=pdftools
POSTGRES_DB=pdftools
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_FILE_SIZE_MB=99

# Frontend
FRONTEND_PORT=3000
# Body size limit untuk SvelteKit adapter-node proxy (bytes). 104857600 = 100 MB
BODY_SIZE_LIMIT=104857600

# Worker
OUTPUT_TTL_HOURS=24
SWEEP_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

